# Public deployment origin used for absolute Open Graph image URLs.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only URL for the PyTorch inference service. Do not use NEXT_PUBLIC_.
# JARVISNT_INFERENCE_URL=https://your-inference-host.example.com
# JARVISNT_INFERENCE_API_KEY=replace-me

# Chat protection. The defaults are 10 requests per IP per minute and a
# 55-second upstream timeout. Configure these in the Vercel project settings.
# JARVISNT_RATE_LIMIT=10
# JARVISNT_INFERENCE_TIMEOUT_MS=55000
