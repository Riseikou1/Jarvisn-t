# Public deployment origin used for absolute Open Graph image URLs.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only RunPod Serverless endpoint URL. Use the endpoint's /runsync URL.
# Never add NEXT_PUBLIC_ to either of these variables.
# JARVISNT_INFERENCE_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/runsync
# JARVISNT_INFERENCE_API_KEY=your_runpod_api_key

# Chat protection. Defaults: 10 requests per IP per minute, 55-second timeout.
# JARVISNT_RATE_LIMIT=10
# JARVISNT_INFERENCE_TIMEOUT_MS=55000
